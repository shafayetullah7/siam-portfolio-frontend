# =============================================================================
# SIAM frontend — VITE_* is inlined at `pnpm build` (not read at `pnpm start`).
# Never put secrets in VITE_* — they ship in the browser bundle.
# See docs/frontend-developer-guide.md §8 and docs/api-convention.md §11.
# =============================================================================

# Full API URL — browser and SSR use the same base (Nest CORS_ORIGIN must match app origin)
VITE_API_BASE=http://localhost:5000/api/v1
# Canonical site URL for sitemap.xml / robots.txt (must match siam-api CORS_ORIGIN host)
VITE_SITE_ORIGIN=http://localhost:5001

# Rare: SSR reaches API on a different host than the browser (e.g. Docker internal DNS)
# VITE_API_SSR_ORIGIN=http://host.docker.internal:5000

# Production example:
# VITE_API_BASE=https://api.example.com/api/v1
# VITE_SITE_ORIGIN=https://app.example.com
