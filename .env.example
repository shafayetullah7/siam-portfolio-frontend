# Browser: same-origin /api/v1 → Vite dev proxy → Nest (vite.config.ts)
VITE_API_BASE=/api/v1

# Nest listen port — must match siam-api PORT (default 5000)
VITE_API_PROXY_PORT=5000

# SSR only: absolute API origin when VITE_API_BASE is a path (default http://localhost:<proxy port>)
# VITE_API_SSR_ORIGIN=http://localhost:5000

# Public canonical origin for sitemap.xml (default http://localhost:3000)
# VITE_SITE_ORIGIN=http://localhost:3000

# Production / preview build (pnpm build): VITE_* is inlined — no Vite proxy on pnpm start.
# Use a full API base OR set VITE_API_SSR_ORIGIN to a reachable API at build time:
# VITE_API_BASE=https://api.example.com/api/v1
